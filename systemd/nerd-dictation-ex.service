[Unit]
Description=nerd-dictation-ex daemon - Speech-to-text with persistent model
Documentation=https://github.com/marcusmae/nerd-dictation-ex
After=graphical-session.target
Wants=pipewire.service

[Service]
Type=simple
ExecStart=%h/forge/nerd-dictation-ex/.venv/bin/nerd-dictation-ex-daemon
Restart=on-failure
RestartSec=5

# Окружение
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DISPLAY=:0

[Install]
WantedBy=default.target
