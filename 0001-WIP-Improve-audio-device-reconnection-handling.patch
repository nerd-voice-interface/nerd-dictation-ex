From ec68c8e258cd1d3dfff1ca37a54582dee52a68a5 Mon Sep 17 00:00:00 2001
From: Dmitry Mikushin <dmitry@kernelgen.org>
Date: Thu, 4 Dec 2025 09:41:22 +0100
Subject: [PATCH 1/3] WIP: Improve audio device reconnection handling
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Add exponential backoff for restart delays (0.1s to 5s)
- Reset delay on successful audio read
- Log process errors and stderr for debugging
- Auto-reconnect when microphone device changes

🤖 Generated with [Claude Code](https://claude.com/claude-code)

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/nerd_dictation_ex/cli.py | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/src/nerd_dictation_ex/cli.py b/src/nerd_dictation_ex/cli.py
index 70c0fd0..0958f9e 100644
--- a/src/nerd_dictation_ex/cli.py
+++ b/src/nerd_dictation_ex/cli.py
@@ -336,10 +336,14 @@ class DictationDaemon:
         """Постоянно слушать микрофон и заполнять кольцевой буфер."""
         cmd = _get_audio_command(self.config)
         chunk_size = self.config.get("audio", {}).get("chunk_size", 8000)
+        restart_delay = 0.1  # Начальная задержка перед перезапуском
+        max_restart_delay = 5.0  # Максимальная задержка
 
         while self._running:
             try:
-                self._audio_proc = subprocess.Popen(cmd, stdout=subprocess.PIPE)
+                self._audio_proc = subprocess.Popen(
+                    cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE
+                )
 
                 # Блокирующее чтение — ждём пока накопится chunk_size байт
                 while self._running and self._audio_proc.poll() is None:
@@ -353,11 +357,21 @@ class DictationDaemon:
                                 self._wake_word_queue.put_nowait(chunk)
                             except:
                                 pass  # Очередь переполнена - пропускаем
+                        # Сброс задержки при успешном чтении
+                        restart_delay = 0.1
                     elif not chunk:
                         # EOF или процесс завершился
                         break
+
+                # Проверяем код возврата процесса
+                if self._audio_proc.poll() is not None and self._audio_proc.returncode != 0:
+                    stderr = self._audio_proc.stderr.read().decode().strip()
+                    print(f"[audio] Процесс завершился с кодом {self._audio_proc.returncode}", file=sys.stderr)
+                    if stderr:
+                        print(f"[audio] {stderr[:200]}", file=sys.stderr)
+
             except Exception as e:
-                print(f"Ошибка аудио-слушателя: {e}", file=sys.stderr)
+                print(f"[audio] Ошибка: {e}", file=sys.stderr)
             finally:
                 if self._audio_proc:
                     self._audio_proc.terminate()
@@ -365,7 +379,10 @@ class DictationDaemon:
                     self._audio_proc = None
 
             if self._running:
-                time.sleep(0.5)  # Пауза перед перезапуском
+                print(f"[audio] Перезапуск через {restart_delay:.1f}с...", file=sys.stderr)
+                time.sleep(restart_delay)
+                # Экспоненциальный backoff при повторных ошибках
+                restart_delay = min(restart_delay * 2, max_restart_delay)
 
     def _audio_stream(self) -> Generator[bytes, None, None]:
         """Генератор аудио-чанков: сначала буфер, потом живой поток."""
